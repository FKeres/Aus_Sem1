@page "/"
@inject HomeService HomeService
@inject ParcelService ParcelService
@inject PropertyService PropertyService
@rendermode InteractiveServer

<PageTitle>All</PageTitle>

<h1>All</h1>

<button class="btn btn-primary" @onclick="ShowSearchAllDialog">Search with GPS</button>
<button class="btn btn-danger" @onclick="ShowTestDialog">Test operations</button>
<button class="btn btn-info" @onclick="ShowSaveDialog">Save</button>
<button class="btn btn-dark" @onclick="ShowLoadDialog">Load</button>
<button class="btn btn-dark" @onclick="ShowGenerateDialog">Generate</button>
<button class="btn btn-dark" @onclick="ShowAll">Show All</button>

@if ((_propParcHolder == null && _propParcHolder1 == null) || (_propParcHolder.Count == 0 && _propParcHolder1.Count == 0))
{
    <p><em>Loading...</em></p>
}
else
{
    @if (_propParcHolder == null && _propParcHolder1 == null)
    {
        <p><em>No teritorial units to display</em></p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>TU Identification number</th>
                    <th>TU description</th>
                    <th>GPS1 width</th>
                    <th>GPS1 width position</th>
                    <th>GPS1 length</th>
                    <th>GPS2 length position</th>
                    <th>GPS2 width</th>
                    <th>GPS2 width position</th>
                    <th>GPS2 length</th>
                    <th>GPS2 length position</th>
                </tr>
            </thead>
            <tbody>
                @if (_propParcHolder != null) 
                {
                    @foreach (var propParc in _propParcHolder)
                    {
                        @if(propParc.Parcel != null) {
                            <tr>
                                <td>@propParc.Parcel.ParcNo</td>
                                <td>@propParc.Parcel.ParcDesc</td>
                                <td>@propParc.Parcel.GpsPosHandler.GpsPositioons[0].Width</td>
                                <td>@propParc.Parcel.GpsPosHandler.GpsPositioons[0].WidthPosition</td>
                                <td>@propParc.Parcel.GpsPosHandler.GpsPositioons[0].Length</td>
                                <td>@propParc.Parcel.GpsPosHandler.GpsPositioons[0].LengthPosition</td>
                                <td>@propParc.Parcel.GpsPosHandler.GpsPositioons[1].Width</td>
                                <td>@propParc.Parcel.GpsPosHandler.GpsPositioons[1].WidthPosition</td>
                                <td>@propParc.Parcel.GpsPosHandler.GpsPositioons[1].Length</td>
                                <td>@propParc.Parcel.GpsPosHandler.GpsPositioons[1].LengthPosition</td>
                            </tr>
                        } else {
                            <tr>
                                <td>@propParc.Property.InventNo</td>
                                <td>@propParc.Property.PropDesc</td>
                                <td>@propParc.Property.GpsPosHandler.GpsPositioons[0].Width</td>
                                <td>@propParc.Property.GpsPosHandler.GpsPositioons[0].WidthPosition</td>
                                <td>@propParc.Property.GpsPosHandler.GpsPositioons[0].Length</td>
                                <td>@propParc.Property.GpsPosHandler.GpsPositioons[0].LengthPosition</td>
                                <td>@propParc.Property.GpsPosHandler.GpsPositioons[1].Width</td>
                                <td>@propParc.Property.GpsPosHandler.GpsPositioons[1].WidthPosition</td>
                                <td>@propParc.Property.GpsPosHandler.GpsPositioons[1].Length</td>
                                <td>@propParc.Property.GpsPosHandler.GpsPositioons[1].LengthPosition</td>
                            </tr>
                        }
                    }
                }
                @if (_propParcHolder1 != null) 
                {
                    @foreach (var propParc1 in _propParcHolder1)
                    {
                        @if(propParc1.Parcel != null) {
                            <tr>
                                <td>@propParc1.Parcel.ParcNo</td>
                                <td>@propParc1.Parcel.ParcDesc</td>
                                <td>@propParc1.Parcel.GpsPosHandler.GpsPositioons[0].Width</td>
                                <td>@propParc1.Parcel.GpsPosHandler.GpsPositioons[0].WidthPosition</td>
                                <td>@propParc1.Parcel.GpsPosHandler.GpsPositioons[0].Length</td>
                                <td>@propParc1.Parcel.GpsPosHandler.GpsPositioons[0].LengthPosition</td>
                                <td>@propParc1.Parcel.GpsPosHandler.GpsPositioons[1].Width</td>
                                <td>@propParc1.Parcel.GpsPosHandler.GpsPositioons[1].WidthPosition</td>
                                <td>@propParc1.Parcel.GpsPosHandler.GpsPositioons[1].Length</td>
                                <td>@propParc1.Parcel.GpsPosHandler.GpsPositioons[1].LengthPosition</td>
                            </tr>
                        } else {
                            <tr>
                                <td>@propParc1.Property.InventNo</td>
                                <td>@propParc1.Property.PropDesc</td>
                                <td>@propParc1.Property.GpsPosHandler.GpsPositioons[0].Width</td>
                                <td>@propParc1.Property.GpsPosHandler.GpsPositioons[0].WidthPosition</td>
                                <td>@propParc1.Property.GpsPosHandler.GpsPositioons[0].Length</td>
                                <td>@propParc1.Property.GpsPosHandler.GpsPositioons[0].LengthPosition</td>
                                <td>@propParc1.Property.GpsPosHandler.GpsPositioons[1].Width</td>
                                <td>@propParc1.Property.GpsPosHandler.GpsPositioons[1].WidthPosition</td>
                                <td>@propParc1.Property.GpsPosHandler.GpsPositioons[1].Length</td>
                                <td>@propParc1.Property.GpsPosHandler.GpsPositioons[1].LengthPosition</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    }
}
@if (isSearchDialogVisible)
{
    <div class="modal fade show" tabindex="-1" role="dialog" style="display:block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Search Parcel</h5>
                    <button type="button" class="btn-close" @onclick="CloseSearchAllDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="gpsWToSearch1" class="form-label">GPS1 width position</label>
                        <input type="number" class="form-control" id="gpsWToSearch1" @bind="_gpsWToSearch1" />
                    </div>
                    <div class="mb-3">
                        <label for="gpsLToSearch1" class="form-label">GPS1 length position</label>
                        <input type="number" class="form-control" id="gpsLToSearch1" @bind="_gpsLToSearch1" />
                    </div>
                    <div class="mb-3">
                        <label for="gpsWToSearch2" class="form-label">GPS2 width position</label>
                        <input type="number" class="form-control" id="gpsWToSearch2" @bind="_gpsWToSearch2" />
                    </div>
                    <div class="mb-3">
                        <label for="gpsLToSearch2" class="form-label">GPS2 length position</label>
                        <input type="number" class="form-control" id="gpsLToSearch2" @bind="_gpsLToSearch2" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseSearchAllDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SearchAll">Search</button>
                </div>
            </div>
        </div>
    </div>
}

@if (isTestDialogVisible)
{
    <div class="modal fade show" tabindex="-1" role="dialog" style="display:block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Search Parcel</h5>
                    <button type="button" class="btn-close" @onclick="CloseTestDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="operNum" class="form-label">Number of operations</label>
                        <input type="number" class="form-control" id="operNum" @bind="_operNum" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseTestDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="TestOperations">Test</button>
                </div>
            </div>
        </div>
    </div>
}

@if (isSaveDialogVisible)
{
    <div class="modal fade show" tabindex="-1" role="dialog" style="display:block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Save File</h5>
                    <button type="button" class="btn-close" @onclick="CloseSaveDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="filePathProp" class="form-label">File Path for Properties</label>
                        <input type="text" class="form-control" id="filePathParc" @bind="_filePathProp" />
                    </div>
                    <div class="mb-3">
                        <label for="filePathParc" class="form-label">File Path for Parcels</label>
                        <input type="text" class="form-control" id="filePathProp" @bind="_filePathParc" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseSaveDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="Save">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (isLoadDialogVisible)
{
    <div class="modal fade show" tabindex="-1" role="dialog" style="display:block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Load File</h5>
                    <button type="button" class="btn-close" @onclick="CloseLoadDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="filePathProp" class="form-label">File Path for Properties</label>
                        <input type="text" class="form-control" id="filePathParc" @bind="_filePathProp" />
                    </div>
                    <div class="mb-3">
                        <label for="filePathParc" class="form-label">File Path for Parcels</label>
                        <input type="text" class="form-control" id="filePathProp" @bind="_filePathParc" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseLoadDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="Load">Load</button>
                </div>
            </div>
        </div>
    </div>
}

@if (isGenerateDialogVisible)
{
    <div class="modal fade show" tabindex="-1" role="dialog" style="display:block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Generate Data</h5>
                    <button type="button" class="btn-close" @onclick="CloseGenerateDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="propNum" class="form-label">Number of generated properties</label>
                        <input type="number" class="form-control" id="propNum" @bind="_propNum" />
                    </div>
                    <div class="mb-3">
                        <label for="parcNum" class="form-label">Number of generated parcels</label>
                        <input type="number" class="form-control" id="parcNum" @bind="_parcNum" />
                    </div>
                    <div class="mb-3">
                        <label for="coverPerc" class="form-label">Percent of covering (type whole number like 50 or 20 ...)</label>
                        <input type="number" class="form-control" id="coverPerc" @bind="_coverPerc" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseGenerateDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="Generate">Generate</button>
                </div>
            </div>
        </div>
    </div>
}

@if (isTestResultVisible)
{
    <div class="modal fade show" tabindex="-1" role="dialog" style="display:block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Test Result</h5>
                </div>
                <div class="modal-body">
                    <p>@_testResultMessage</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="CloseTetsResult">OK</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PropParcHolder> _propParcHolder = new List<PropParcHolder>();
    private List<PropParcHolder>? _propParcHolder1 = new List<PropParcHolder>();
    private double _gpsWToSearch1, _gpsLToSearch1, _gpsWToSearch2, _gpsLToSearch2;
    private bool isSearchDialogVisible = false;
    private bool isTestDialogVisible = false;
    private bool isSaveDialogVisible = false;
    private bool isLoadDialogVisible = false;
    private bool isGenerateDialogVisible = false;
    private int _operNum;
    private int _propNum;
    private int _parcNum;
    private int _coverPerc;
    private string? _filePathProp;
    private string? _filePathParc;
    private string _testResultMessage;
    private bool isTestResultVisible = false;

    void ShowSearchParcelDialog()
    {
        isSearchDialogVisible = true;
        StateHasChanged();
    }


    void SearchAll() {
        _propParcHolder = HomeService.SearchAll(_gpsWToSearch1, _gpsLToSearch1);
        _propParcHolder1 = HomeService.SearchAll(_gpsWToSearch2, _gpsLToSearch2);
        isSearchDialogVisible = false;
        _gpsWToSearch1 = 0.0;
        _gpsLToSearch1 = 0.0;
        _gpsWToSearch2 = 0.0;
        _gpsLToSearch2 = 0.0;
        StateHasChanged();
    }

    void ShowSearchAllDialog()
    {
        isSearchDialogVisible = true;
        StateHasChanged();
    }

     void CloseSearchAllDialog()
    {
        isSearchDialogVisible = false;
        _gpsWToSearch1 = 0.0;
        _gpsLToSearch1 = 0.0;
        _gpsWToSearch2 = 0.0;
        _gpsLToSearch2 = 0.0;
        StateHasChanged();
    }

    void ShowTestDialog()
    {
        isTestDialogVisible = true;
        StateHasChanged();
    }

    void CloseTestDialog() {
        isTestDialogVisible = false;
        StateHasChanged();
    }

    async Task TestOperations() {
        bool result = await HomeService.TestOperations(_operNum);
        _testResultMessage = result ? "Test successful!" : "Test failed!";
        isTestResultVisible = true;
        isTestDialogVisible = false;
        StateHasChanged();
    }

    void ShowSaveDialog() {
        _filePathParc = "";
        _filePathProp = "";
        isSaveDialogVisible = true;
        StateHasChanged();
    }

    void CloseSaveDialog() {
        isSaveDialogVisible = false;
        StateHasChanged();
    }

    void Save() {
        PropertyService.SaveState(_filePathProp);
        ParcelService.SaveState(_filePathParc);
        isSaveDialogVisible = false;
        StateHasChanged();
    }

    void ShowLoadDialog() {
        _filePathParc = "";
        _filePathProp = "";
        isLoadDialogVisible = true;
        StateHasChanged();
    }

    void CloseLoadDialog() {
        isLoadDialogVisible = false;
        StateHasChanged();
    }

    void Load() {
        PropertyService.LoadState(_filePathProp);
        ParcelService.LoadState(_filePathParc);
        isLoadDialogVisible = false;
        StateHasChanged();
    }

    void ShowGenerateDialog() {
        _propNum = 0;
        _parcNum = 0;
        _coverPerc = 0;
        isGenerateDialogVisible = true;
        StateHasChanged();
    }

    void CloseGenerateDialog() {
        isGenerateDialogVisible = false;
        StateHasChanged();
    }

    void Generate() {
        List<List<double>> keys = new List<List<double>>();
        keys = ParcelService.GenerateParc(_parcNum);
        Console.WriteLine(_coverPerc);
        PropertyService.GenerateProp(_propNum, _coverPerc, keys);
        isGenerateDialogVisible = false;
        StateHasChanged();
    }

    void CloseTetsResult() {
        isTestResultVisible = false;
        StateHasChanged();
    }

    void ShowAll() {
        _propParcHolder = HomeService.GetAll();
        _propParcHolder1 = null;
        StateHasChanged();
    }
}
